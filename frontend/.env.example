# =============================================================================
# Frontend - Environment Variables
# =============================================================================
# Frontend-specific environment variables
# Copy this file to .env in the frontend directory
# NOTE: NEXT_PUBLIC_ variables are exposed to the browser - DO NOT put secrets here!
# =============================================================================

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_VERSION=v1

# Feature Flags
NEXT_PUBLIC_FEATURE_FILE_UPLOAD_ENABLED=true
NEXT_PUBLIC_FEATURE_DRAFT_SAVE_ENABLED=true

# UI Configuration
NEXT_PUBLIC_APP_NAME=TaskFlow Pro Support
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com
NEXT_PUBLIC_MAX_FILE_SIZE=5242880
NEXT_PUBLIC_MAX_FILES=3

# Analytics (Optional)
NEXT_PUBLIC_ANALYTICS_ID=your-analytics-id
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
