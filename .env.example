# =============================================================================
# Customer Success FTE - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=DEBUG
SECRET_KEY=your-super-secret-key-change-in-production

# -----------------------------------------------------------------------------
# Openrouter API Configuration
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-your-openrouter-api-key
OPENROUTER_MODEL=gpt-4o

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://fte_user:fte_password@localhost:5432/fte_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=fte_user
POSTGRES_PASSWORD=fte_password
POSTGRES_DB=fte_db

# -----------------------------------------------------------------------------
# Kafka Configuration
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TICKETS_INCOMING=fte.tickets.incoming
KAFKA_TOPIC_ESCALATIONS=fte.escalations
KAFKA_TOPIC_METRICS=fte.metrics
KAFKA_CONSUMER_GROUP_ID=fte-message-processor

# -----------------------------------------------------------------------------
# Gmail API Configuration
# -----------------------------------------------------------------------------
GMAIL_ENABLED=true
GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REDIRECT_URI=http://localhost:8000/webhooks/gmail/callback
GMAIL_TOPIC_ID=https://console.cloud.google.com/cloudpubsub/topic/detail/gmail-notification?project=digital-fte-490421
GMAIL_CREDENTIALS_PATH=./credentials/gmail-credentials.json

# -----------------------------------------------------------------------------
# Twilio WhatsApp Configuration
# -----------------------------------------------------------------------------
WHATSAPP_ENABLED=true
TWILIO_ACCOUNT_SID=AC-your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_WEBHOOK_URL=http://localhost:8000/webhooks/whatsapp

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000"]
CORS_ALLOW_CREDENTIALS=true

# -----------------------------------------------------------------------------
# File Upload Configuration
# -----------------------------------------------------------------------------
MAX_FILE_SIZE=5242880
MAX_FILES_PER_UPLOAD=3
UPLOAD_DIR=./uploads

# -----------------------------------------------------------------------------
# Kubernetes Configuration (Production Only)
# -----------------------------------------------------------------------------
K8S_NAMESPACE=customer-success-fte
K8S_BACKEND_IMAGE=your-registry/customer-success-fte:latest

# -----------------------------------------------------------------------------
# Monitoring & Alerting
# -----------------------------------------------------------------------------
METRICS_ENABLED=true
METRICS_PORT=9090
ALERTING_WEBHOOK_URL=your-alerting-webhook-url

# -----------------------------------------------------------------------------
# Security Settings
# -----------------------------------------------------------------------------
API_KEY_HEADER=X-API-Key
API_KEYS=your-api-key-1,your-api-key-2
JWT_SECRET=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# -----------------------------------------------------------------------------
# Email Configuration (For notifications)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@yourdomain.com

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
FEATURE_SEMANTIC_SEARCH_ENABLED=true
FEATURE_AUTO_ESCALATION_ENABLED=true
FEATURE_SENTIMENT_ANALYSIS_ENABLED=true
FEATURE_CROSS_CHANNEL_CONTINUITY_ENABLED=true

# -----------------------------------------------------------------------------
# Performance Settings
# -----------------------------------------------------------------------------
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE=3600
KAFKA_CONSUMER_AUTO_OFFSET_RESET=earliest
KAFKA_CONSUMER_ENABLE_AUTO_COMMIT=true

# -----------------------------------------------------------------------------
# Development Settings
# -----------------------------------------------------------------------------
DEBUG=true
RELOAD=true
ALLOWED_HOSTS=localhost,127.0.0.1
