# =============================================================================
# Backend - Environment Variables
# =============================================================================
# Backend-specific environment variables
# Copy this file to .env in the backend directory
# =============================================================================

# Application
ENVIRONMENT=development
LOG_LEVEL=DEBUG
SECRET_KEY=your-backend-secret-key

# Database
DATABASE_URL=postgresql+asyncpg://fte_user:fte_password@localhost:5432/fte_db

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Gmail
GMAIL_ENABLED=true
GMAIL_CREDENTIALS_PATH=./secrets/credentials.json

# Twilio
TWILIO_ACCOUNT_SID=AC-your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
